# ShortSmash secrets — copy to .env (never commit this file).
# Only the keys for features you use are needed.

# Script writer — pick one (both free, no credit card). NVIDIA is preferred
# (OpenAI-compatible, ~40 RPM free tier): https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=
# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stock footage — pick one (both have free tiers):
# https://www.pexels.com/api/  (default provider)
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Publishers (official APIs only) ---
# YouTube: OAuth client JSON goes to ~/.shortsmash/youtube_client.json (see docs/setup-youtube.md)
# TikTok Content Posting API (see docs/setup-tiktok.md)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Instagram Graph API (see docs/setup-instagram.md)
IG_ACCESS_TOKEN=
IG_USER_ID=
# X API v2 (see docs/setup-x.md)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
